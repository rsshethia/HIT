# Copy to .env (local) or set as environment variables on Render.
# Never commit real secrets.

# Required — PostgreSQL connection (Render Postgres internal or external URL)
DATABASE_URL=postgresql://user:password@host:5432/hit

# Optional — Render injects PORT automatically. Local default is 5000.
PORT=5000

# Required once per database — create tables (diagrams, ...):
#   npx drizzle-kit push
# Run against the Render Postgres DATABASE_URL before/after first deploy.
# Note: map_systems + map_system_history tables were removed with the
# Healthcare Systems Map (see docs/archive). Dropping them is optional —
# `drizzle-kit push` will prompt about tables missing from the schema.

# Optional — Vite build-time only
# NODE_ENV=production
